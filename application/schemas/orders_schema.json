{
    "title": "Orders schema",
    "type": "object",
    "properties": {
        "order_id": {
            "type": "integer",
            "exclusiveMinimum": 0
        },
        "weight": {
            "type": "number",
            "exclusiveMinimum": 0
        },
        "region": {
            "type": "integer",
            "exclusiveMinimum": 0
        },
        "delivery_hours": {
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]-(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]$"
            },
            "minItems": 1
        }
    },
    "additionalProperties": false,
    "required": [
        "order_id",
        "weight",
        "region",
        "delivery_hours"
    ]

}
