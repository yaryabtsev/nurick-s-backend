{
    "title": "Courier info",
    "type": "object",
    "properties": {
        "courier_id": {
            "type": "integer",
            "exclusiveMinimum": 0
        },
        "courier_type": {
            "type": "string",
            "enum": [
                "foot",
                "bike",
                "car"
            ]
        },
        "regions": {
            "type": "array",
            "items": {
                "type": "integer",
                "exclusiveMinimum": 0
            },
            "minItems": 1
        },
        "working_hours": {
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]-(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]$"
            },
            "minItems": 1
        }
    },
    "additionalProperties": false,
    "required": [
        "courier_id",
        "courier_type",
        "regions",
        "working_hours"
    ]
}

